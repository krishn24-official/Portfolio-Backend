# Free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# The origin your React portfolio is served from.
# Local dev default (Vite): http://localhost:5173
# Production: your deployed portfolio URL, e.g. https://krishn24.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Email notifications for /contact endpoint
# The email address where visitor messages should be delivered
OWNER_EMAIL=your_email@example.com

# Gmail address used to send the notification email via SMTP
GMAIL_ADDRESS=your_gmail_address@gmail.com

# 16-character Google App Password (NOT your real Gmail account password).
# Requirements:
# 1. 2-Step Verification must be enabled on your Google account.
# 2. Generate a 16-char password at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

