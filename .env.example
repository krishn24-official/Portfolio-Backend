# Free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# The origin your React portfolio is served from.
# Local dev default (Vite): http://localhost:5173
# Production: your deployed portfolio URL, e.g. https://krishn24.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Email notifications for /contact endpoint
# The email address where visitor messages should be delivered
OWNER_EMAIL=your_email@example.com

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here


